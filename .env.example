POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

KAFKA_EXTERNAL_PORT=9092
KAFBAT_PORT=8080

# LLM_PROVIDER selects the provider. Each provider reads its API key from its own
# env var - only the one matching LLM_PROVIDER is required, the rest can stay unset:
#   anthropic  -> ANTHROPIC_API_KEY
#   openai     -> OPENAI_API_KEY
#   openrouter -> OPENROUTER_API_KEY
# LLM_BASE_URL is only needed for a self-hosted OpenAI-compatible endpoint (e.g. Ollama)
# and is not tied to any particular env var name.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/auto-beta
LLM_API_KEY=
LLM_BASE_URL=

# ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=